{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-seo.js && vite build && node scripts/generate-radarr-feeds.js && node scripts/inject-seo-assets.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cast:inspect": "node scripts/enrich-cast.js --inspect",
    "cast:rebuild": "node scripts/enrich-cast.js --rebuild",
    "cast:refresh": "node scripts/enrich-cast.js --refresh",
    "assets:migrate": "node scripts/migrate-local-assets.js",
    "catalog:refresh": "node scripts/refresh-catalog.js",
    "catalog:manifest:check": "node scripts/sync-catalog-manifest.js --validate-only",
    "catalog:manifest:sync": "node scripts/sync-catalog-manifest.js",
    "seo:refresh": "node scripts/generate-seo.js",
    "test": "node --test scripts/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.2"
  }
}
