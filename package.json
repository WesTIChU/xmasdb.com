    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "refresh:actors": "tsx scripts/refresh-actors.ts",
    "refresh:tmdb": "tsx scripts/refresh-tmdb.ts",
    "test:browser": "tsx scripts/test-production-browser.ts",
    "discover:gaf": "tsx scripts/gaf-catalogue.ts --discover",
    "import:gaf": "tsx scripts/gaf-catalogue.ts --import",
    "discover:lifetime": "tsx scripts/lifetime-catalogue.ts",
    "import:lifetime": "tsx scripts/lifetime-catalogue.ts --import",
    "import:lifetime-reviewed": "tsx scripts/lifetime-catalogue.ts --import-reviewed",
    "verify:lifetime-history": "tsx scripts/verify-lifetime-history.ts",
    "audit:gaf-pending": "tsx scripts/audit-gaf-pending.ts",
    "add:movie": "tsx scripts/add-movie.ts",
    "audit:local": "tsx scripts/audit-local.ts",
    "reconcile:lifecycle": "tsx scripts/reconcile-lifecycle.ts",
    "import:xmasdb": "tsx scripts/import-xmasdb.ts",
    "test": "tsx test/actors.test.ts && tsx test/admin-movies.test.ts && tsx test/admin-refresh.test.ts && tsx test/admin.test.ts && tsx test/analytics.test.ts && tsx test/catalogue.test.ts && tsx test/contact.test.ts && tsx test/crew.test.ts && tsx test/feed-statistics.test.ts && tsx test/feeds.test.ts && tsx test/feed-rate-limit.test.ts && tsx test/hallmark-2026.test.ts && tsx test/seo.test.ts && tsx test/search.test.ts && tsx test/tmdb-refresh.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
